<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/customize_dashboard_title">

        <com.android.settingslib.widget.TopIntroPreference
             android:key="customize_top_intro"
             android:title="@string/build_tweaks_summary_title"
             settings:searchable="false"/>

        <!-- Top (Lockscreen, About, and Quick settings)-->
         <com.android.settingslib.widget.LayoutPreference
             android:key="interface_menu_top"
             android:layout="@layout/interface_menu_top_layout"/>    

         <PreferenceCategory
             android:id="@+id/more_menu"
             android:title="@string/more_menu_title">

        <!-- Themes -->
             <Preference
                 android:key="themes_category"
                 android:title="@string/themes_title"
                 android:fragment="com.epic.settings.fragments.themes.Themes"
                 android:icon="@drawable/ic_settings_themes"
                 settings:layout="@layout/interface_card_single_unsummary" />

        <!-- Status bar -->
             <Preference
                 android:key="statusbar_category"
                 android:title="@string/statusbar_title"
                 android:fragment="com.epic.settings.fragments.statusbar.StatusBar"
                 android:icon="@drawable/ic_settings_statusbar"
                 settings:layout="@layout/interface_card_single_unsummary" />

        <!-- Notifications -->
             <Preference
                 android:key="notifications_category"
                 android:title="@string/notifications_title"
                 android:fragment="com.epic.settings.fragments.notifications.Notifications"
                 android:icon="@drawable/ic_settings_notifications"
                 settings:layout="@layout/interface_card_single_unsummary" />        

        <!-- Buttons -->
             <Preference
                 android:key="buttons_category"
                 android:title="@string/buttons_title"
                 android:fragment="com.epic.settings.fragments.buttons.Buttons"
                 android:icon="@drawable/ic_settings_buttons"
                 settings:layout="@layout/interface_card_single_unsummary" />

        <!-- Power menu -->
     <Preference
         android:key="power_menu"
         android:title="@string/power_menu_title"
         android:icon="@drawable/ic_settings_power_menu"
         android:fragment="com.epic.settings.fragments.powermenu.PowerMenu"
         settings:layout="@layout/interface_card_single_unsummary" />  

        <!-- Misc -->
        <Preference
            android:key="misc_category"
            android:title="@string/misc_title" 
            android:fragment="com.epic.settings.fragments.miscellaneous.Miscellaneous"
            android:icon="@drawable/ic_settings_misc"
            settings:layout="@layout/interface_card_single_unsummary" />
                     
</PreferenceScreen>